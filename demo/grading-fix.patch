diff --git a/tests/test_quiz_grading.py b/tests/test_quiz_grading.py
new file mode 100644
--- /dev/null
+++ b/tests/test_quiz_grading.py
@@ -0,0 +1,23 @@
+import pytest
+
+from app.modules.quiz.grading import is_answer_accepted
+
+
+@pytest.mark.parametrize(
+    ("user_answer", "expected_answer", "accepted"),
+    [
+        ("10", "10", True),
+        ("10.00", "10", True),
+        ("10.009", "10", True),
+        ("10.02", "10", False),
+        ("1,000", "1000", True),
+        ("java3", "python3", False),
+        ("status 404", "http 404", False),
+    ],
+)
+def test_numeric_tolerance_applies_only_to_numeric_answers(
+    user_answer: str,
+    expected_answer: str,
+    accepted: bool,
+) -> None:
+    assert is_answer_accepted(user_answer, expected_answer) is accepted
diff --git a/frontend/tests/answerMatcher.test.mjs b/frontend/tests/answerMatcher.test.mjs
--- a/frontend/tests/answerMatcher.test.mjs
+++ b/frontend/tests/answerMatcher.test.mjs
@@ -16,3 +16,19 @@
 test("rejects an unrelated short answer", () => {
   assert.equal(isAnswerAccepted("api", "dom"), false);
 });
+
+const numericPolicyCases = [
+  ["10", "10", true],
+  ["10.00", "10", true],
+  ["10.009", "10", true],
+  ["10.02", "10", false],
+  ["1,000", "1000", true],
+  ["java3", "python3", false],
+  ["status 404", "http 404", false],
+];
+
+for (const [userAnswer, expectedAnswer, accepted] of numericPolicyCases) {
+  test(`${userAnswer} vs ${expectedAnswer} -> ${accepted}`, () => {
+    assert.equal(isAnswerAccepted(userAnswer, expectedAnswer), accepted);
+  });
+}
